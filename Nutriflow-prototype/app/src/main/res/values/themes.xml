<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.NutriFlow" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/emerald_600</item>
        <item name="android:colorPrimaryDark">@color/emerald_700</item>
        <item name="android:colorAccent">@color/emerald_500</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/emerald_700</item>
        <item name="android:navigationBarColor">@color/emerald_700</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/stone_50</item>
    </style>
    
    <!-- Splash Screen Theme -->
    <style name="Theme.NutriFlow.Splash" parent="Theme.NutriFlow">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
