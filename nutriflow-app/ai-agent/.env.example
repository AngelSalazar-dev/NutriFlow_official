# ===========================================
# NutriFlow AI Agent - Environment Variables
# ===========================================
# Copia este archivo como .env
# ===========================================

# -------------------------------------------
# NutriFlow API
# -------------------------------------------
# URL de tu aplicación NutriFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Key para que la IA se autentique
# Genera una con: openssl rand -hex 32
AI_AGENT_API_KEY=

# -------------------------------------------
# OpenAI (Generación de contenido)
# -------------------------------------------
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Alternativa: Anthropic (Claude)
# Obtén tu API key en: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------
# Social Media (Publicación automática)
# -------------------------------------------
# Buffer: https://buffer.com
# Ve a Settings → API después de registrar tu cuenta
BUFFER_ACCESS_TOKEN=

# Alternativa: Hootsuite
# HOOTSUITE_API_KEY=

# -------------------------------------------
# Email Marketing
# -------------------------------------------
# SendGrid: https://sendgrid.com
# Ve a Settings → API Keys
SENDGRID_API_KEY=SG.xxxxx

# Alternativa: Resend (más moderno)
# RESEND_API_KEY=re_xxxxx

# -------------------------------------------
# Google AdSense (Opcional - para producción)
# -------------------------------------------
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXX
