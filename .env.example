# ===========================================
# NUTRIFLOW - VARIABLES DE ENTORNO PARA PRODUCCIÓN (VERCEL)
# ===========================================
# Copia este archivo como .env.local para desarrollo local
# Para Vercel, configura estas variables en el dashboard de Vercel
# ===========================================

# -------------------------------------------
# BASE DE DATOS (MySQL en la nube)
# Recomendado: PlanetScale, Railway, o AWS RDS
# -------------------------------------------
MYSQL_HOST=db.railway.app
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_de_produccion_aqui
MYSQL_DATABASE=nutriflow_db

# -------------------------------------------
# JWT SECRET (IMPORTANTE: Cambia esto en producción!)
# Genera uno nuevo con: openssl rand -base64 64
# -------------------------------------------
JWT_SECRET=tu-clave-secreta-muy-larga-y-segura-cambiala-en-produccion-12345

# -------------------------------------------
# STRIPE (Pagos)
# Configura las claves de Stripe en el dashboard de Vercel
# -------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -------------------------------------------
# URL DE LA APLICACIÓN
# Para producción, usa tu dominio de Vercel
# -------------------------------------------
NEXT_PUBLIC_APP_URL=https://nutriflow.vercel.app

# -------------------------------------------
# AI/LLM API Key (Opcional)
# Para el chatbot de nutrición
# -------------------------------------------
EMERGENT_LLM_KEY=sk-emergent-tu-api-key

# -------------------------------------------
# VARIABLES DE VERCEL (Automáticas)
# Vercel provee estas automáticamente:
# - VERCEL_URL (ej: nutriflow.vercel.app)
# - VERCEL_ENV (production, preview, development)
# -------------------------------------------
